# ─────────────────────────────────────────────────────────────
#  TossPayments 키 설정
#  복사해서 `.env.local` 파일을 만든 뒤 값을 채워주세요.
#    cp .env.example .env.local
#
#  TEST 모드 키는 토스페이먼츠 개발자센터의 공개 테스트 키입니다.
#  (https://docs.tosspayments.com/reference/using-api/api-keys)
#  실제 결제로 전환하려면 아래 값만 라이브 키로 교체하면 됩니다.
# ─────────────────────────────────────────────────────────────

# 클라이언트 키 (브라우저에 노출됨 / NEXT_PUBLIC_ 접두사 필수)
# 토스페이먼츠 공개 테스트 클라이언트 키
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm

# 시크릿 키 (서버 전용 / 절대 클라이언트에 노출 금지)
# 토스페이먼츠 공개 테스트 시크릿 키
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

# 결제 성공/실패 후 돌아올 사이트의 기본 URL (로컬 개발 기준)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
